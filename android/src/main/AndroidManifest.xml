<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  package="io.swipelab.ux">

  <!-- NotificationsPlugin posts notifications on Android 13+. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- ScreenShareService: a screen capture is granted only while a
       mediaProjection foreground service runs. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

  <application>
    <service
      android:name="io.swipelab.ux.screen.ScreenShareService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection"
      tools:targetApi="q" />

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.ux.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/ux_file_paths" />
    </provider>
  </application>
</manifest>
